# --- Wilma <-> this server ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_API_KEY=
TOKEN_SECRET=
TOKEN_TTL_MIN=60
LOG_LEVEL=info
PORT=3000

# --- Halo API application (Client ID & Secret, login type: Agent) ---
HALO_BASE_URL=https://yourcompany.halopsa.com/api
HALO_AUTH_URL=https://yourcompany.halopsa.com/auth
# Only needed for some hosted instances
HALO_TENANT=
HALO_CLIENT_ID=
HALO_CLIENT_SECRET=
HALO_SCOPE=read:tickets edit:tickets read:customers

# --- Ticket defaults (IDs from Halo config) ---
# Triage ticket type: every Wilma ticket is created as Triage; techs set the real type
HALO_TICKETTYPE_ID=
HALO_TEAM_ID=
HALO_PRIORITY_LOW=
HALO_PRIORITY_NORMAL=
HALO_PRIORITY_HIGH=
# Ticket source, e.g. a "Phone" or "AI Agent" source, if you track it
HALO_TICKET_SOURCE_ID=
# Action outcome used for user updates (e.g. "Note" / "End-User Update")
HALO_UPDATE_OUTCOME_ID=
# Optional: move the ticket to this status when the user adds an update (e.g. "Updated by user")
HALO_UPDATE_NEW_STATUS_ID=
# Comma-separated status IDs treated as closed (Halo default Closed = 9)
HALO_CLOSED_STATUS_IDS=9

# --- Unverified requests (log_unverified_request) ---
# Filed under Halo's Unknown client / General User. Fireside: client 1, site 1, user 19.
# Set HALO_UNVERIFIED_USER_ID to empty to disable the tool.
HALO_UNVERIFIED_USER_ID=19
HALO_UNVERIFIED_CLIENT_ID=1
HALO_UNVERIFIED_SITE_ID=1
UNVERIFIED_REQUESTS_PER_HOUR=3
UNVERIFIED_REQUESTS_GLOBAL_PER_HOUR=30

# --- Test mode (prompt development) ---
# Confines every lookup, ticket and note to the Halo test client, and logs every
# Wilma tool call (arguments + results) to TOOL_LOG_FILE. Forces LOG_LEVEL=debug.
TEST_MODE=false
TEST_CLIENT_ID=273
TEST_USER_ID=338
TEST_UNVERIFIED_USER_ID=311
TEST_SITE_ID=290
# always = anything that doesn't match a test contact verifies as TEST_USER_ID
# match  = real matching against test contacts only (to rehearse failed verifications)
TEST_VERIFY_MODE=always
# For local runs use e.g. ./logs/tool-calls.jsonl
TOOL_LOG_FILE=/data/tool-calls.jsonl
TOOL_LOG_MAX_MB=20

# --- Behaviour ---
DEFAULT_COUNTRY_CODE=1
# true = verified users can see/update any ticket for their company, not just their own
ALLOW_CLIENT_WIDE_TICKETS=false
MAX_PUBLIC_NOTES=3
NOTE_CHAR_LIMIT=600
VERIFY_ATTEMPTS_PER_15MIN=5
